# Server Configuration
NODE_ENV=development
PORT=3000

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_KEY=your-service-role-key-here

# JWT Configuration
JWT_SECRET=your-jwt-secret-here-minimum-32-characters
JWT_EXPIRES_IN=7d

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# PAYMENT WEBHOOK CONFIGURATION (PHASE 3)
# ============================================

# n8n Webhook Secret
# Used for HMAC SHA256 signature verification on payment webhook requests
# This prevents unauthorized payment confirmations from being processed
#
# CRITICAL: This secret MUST match the WEBHOOK_SECRET in your n8n workflow
# "Generate Signature" code node. If they don't match, all payment webhooks
# will be rejected with 400 "Invalid webhook signature" error.
#
# Generate a secure 64-character random secret:
#   openssl rand -hex 32
#
# Example output:
#   7f3d8c9a2b1e4f5a6c7d8e9f0a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8a9b
#
# Security Notes:
# - NEVER commit the actual secret to version control
# - Store only in server .env file
# - Rotate every 90 days for security
# - Use different secrets for dev/staging/production
N8N_WEBHOOK_SECRET=7f3d8c9a2b1e4f5a6c7d8e9f0a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8a9b

# Admin JWT Token
ADMIN_JWT_SECRET=your_admin_jwt_secret_here_minimum_64_chars
CORS_ORIGIN=http://localhost:3000


